# ── Keep these folders but ignore their contents ─────────────────────────────
# (folders tracked via .gitkeep)
exports/*
!exports/.gitkeep
logs/*
!logs/.gitkeep
maps/*
!maps/.gitkeep
!maps/map_service.py
!maps/__init__.py
database/*
!database/.gitkeep
!database/__init__.py